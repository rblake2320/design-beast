{
  "name": "beast-studio-client",
  "version": "1.0.0",
  "description": "Lightweight TypeScript/JavaScript client for the Beast Studio local API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test tests/client.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test:package": "node tests/package-smoke.mjs"
  },
  "files": [
    "dist"
  ],
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@types/node": "^24.12.0",
    "typescript": "^7.0.2"
  }
}
