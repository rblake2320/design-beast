{
  "name": "beast-studio-client",
  "version": "1.0.0",
  "description": "Lightweight TypeScript/JavaScript client for the Beast Studio local API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "test": "node --test tests/client.test.ts tests/distribution.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test:distribution": "python ../../scripts/verify_sdk_distribution_codex_ld.py --typescript-only"
  },
  "files": [
    "dist"
  ],
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
