{
  "components": {
    "schemas": {
      "AnimateReq": {
        "properties": {
          "allow_cloud_fallback": {
            "default": false,
            "title": "Allow Cloud Fallback",
            "type": "boolean"
          },
          "duration": {
            "default": 5,
            "enum": [
              3,
              5
            ],
            "title": "Duration",
            "type": "integer"
          },
          "file": {
            "title": "File",
            "type": "string"
          },
          "motion": {
            "default": "slow cinematic dolly-in, subtle ambient movement",
            "maxLength": 1000,
            "title": "Motion",
            "type": "string"
          },
          "quality": {
            "default": "fast",
            "enum": [
              "fast",
              "cinema"
            ],
            "title": "Quality",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "title": "AnimateReq",
        "type": "object"
      },
      "BackendReq": {
        "properties": {
          "action": {
            "title": "Action",
            "type": "string"
          },
          "name": {
            "title": "Name",
