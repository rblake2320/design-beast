        "properties": {
          "brief": {
            "title": "Brief",
            "type": "string"
          },
          "file": {
            "title": "File",
            "type": "string"
          }
        },
        "required": [
          "file",
          "brief"
        ],
        "title": "JudgeReq",
        "type": "object"
      },
      "RefineReq": {
        "properties": {
          "allow_cloud_fallback": {
            "default": false,
            "title": "Allow Cloud Fallback",
            "type": "boolean"
          },
          "brief": {
            "default": "",
            "title": "Brief",
            "type": "string"
          },
          "file": {
            "title": "File",
            "type": "string"
