            "title": "Recipe",
            "type": "string"
          }
        },
        "required": [
          "brief"
        ],
        "title": "ExpandReq",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
