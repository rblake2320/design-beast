          "instruction": {
            "title": "Instruction",
            "type": "string"
          }
        },
        "required": [
          "file",
          "instruction"
        ],
        "title": "RefineReq",
        "type": "object"
      },
      "RunReq": {
        "properties": {
          "aspect_ratio": {
            "default": "1:1",
            "enum": [
              "1:1",
              "16:9",
              "9:16",
              "4:3",
              "3:4"
            ],
            "title": "Aspect Ratio",
            "type": "string"
          },
          "brief": {
            "maxLength": 2000,
            "minLength": 3,
            "title": "Brief",
            "type": "string"
          },
          "model": {
            "default": "local:flux.1-schnell",
            "enum": [
              "local:flux.1-schnell",
              "local:flux.2-klein",
              "comfy:flux.1-schnell",
              "nim:flux.1-schnell",
              "nim:flux.1-dev",
              "gpt_image_2",
              "nano_banana_2",
              "z_image"
            ],
            "title": "Model",
            "type": "string"
          },
          "prompt": {
            "default": "",
            "maxLength": 4000,
            "title": "Prompt",
            "type": "string"
          },
          "reference": {
            "default": "",
            "title": "Reference",
            "type": "string"
          },
          "variations": {
            "default": [],
            "items": {
              "type": "string"
            },
            "maxItems": 8,
            "title": "Variations",
            "type": "array"
          }
        },
        "required": [
          "brief"
        ],
        "title": "RunReq",
        "type": "object"
      },
      "To3DReq": {
        "properties": {
          "allow_hosted_fallback": {
            "default": false,
