{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-beast.local/schemas/evidence-dataset-rights-v1.json",
  "title": "Beast dataset rights gate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "reviewer_id", "license_id", "rights_basis", "training_allowed", "label_schema_version", "split", "source_manifest_fingerprints"],
  "properties": {
    "schema": {"const": "beast.evidence.dataset-rights/v1"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "license_id": {"type": "string", "minLength": 1},
    "rights_basis": {"type": "string", "minLength": 1},
    "training_allowed": {"const": true},
    "label_schema_version": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "validation", "test"]},
    "source_manifest_fingerprints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
  }
}
