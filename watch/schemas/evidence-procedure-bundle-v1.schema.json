{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-beast.local/schemas/evidence-procedure-bundle-v1.json",
  "title": "Beast evidence procedure bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_manifest", "events", "claims", "execution_receipts", "gates", "bundle_fingerprint"],
  "properties": {
    "schema": {"const": "beast.evidence.procedure-bundle/v1"},
    "source_manifest": {"$ref": "evidence-source-manifest-v1.schema.json"},
    "events": {"type": "array", "minItems": 1, "items": {"$ref": "evidence-event-v1.schema.json"}},
    "claims": {"type": "array", "minItems": 1, "items": {"$ref": "evidence-procedure-claim-v1.schema.json"}},
    "execution_receipts": {"type": "array", "items": {"$ref": "evidence-execution-receipt-v1.schema.json"}},
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_authorized", "evidence_linked", "execution_verified", "promotion_allowed"],
      "properties": {
        "source_authorized": {"type": "boolean"},
        "evidence_linked": {"type": "boolean"},
        "execution_verified": {"type": "boolean"},
        "promotion_allowed": {"type": "boolean"}
      }
    },
    "bundle_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
