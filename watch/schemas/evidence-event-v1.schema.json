{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-beast.local/schemas/evidence-event-v1.json",
  "title": "Beast cross-modal evidence event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_id", "source_manifest_fingerprint", "source_time", "modality", "kind", "content", "confidence", "extractor", "review_state", "artifact_refs", "parent_event_ids", "event_id", "event_fingerprint"],
  "properties": {
    "schema": {"const": "beast.evidence.event/v1"},
    "source_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_manifest_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_ms", "end_ms"],
      "properties": {
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 0}
      }
    },
    "modality": {"enum": ["frame", "transcript", "screen_text", "ui_state", "object", "pose", "landmark", "scene_change", "force_estimate", "location_hypothesis", "reflection_clue", "document", "safety_assessment", "web_detection"]},
    "kind": {"type": "string", "minLength": 1},
    "content": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "config_fingerprint"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "config_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "review_state": {"enum": ["observed", "inferred", "uncertain", "rejected"]},
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "sha256"],
        "properties": {
          "role": {"enum": ["original_media", "original_frame", "deterministic_derivative", "generative_derivative"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "parent_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "operation": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1}
        },
        "allOf": [{
          "if": {"properties": {"role": {"enum": ["deterministic_derivative", "generative_derivative"]}}},
          "then": {"required": ["parent_sha256", "operation"]}
        }]
      }
    },
    "parent_event_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^event-[0-9a-f]{24}$"}},
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interval_95_percent", "method"],
      "properties": {
        "interval_95_percent": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "method": {"type": "string", "minLength": 1}
      }
    },
    "timeline_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_id": {"type": "string", "pattern": "^event-[0-9a-f]{24}$"},
    "event_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [{
    "if": {"properties": {"modality": {"enum": ["force_estimate", "location_hypothesis"]}}},
    "then": {"required": ["uncertainty"]}
  }]
}
