{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-beast.local/schemas/typed-target-v1.json",
  "title": "Beast Watch typed target contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "application", "version", "fields"],
  "properties": {
    "schema": {"const": "beast.watch.typed-target/v1"},
    "application": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {"enum": ["string", "number", "integer", "boolean", "enum", "color_rgba"]},
          "required": {"type": "boolean"},
          "unit": {"type": "string", "minLength": 1},
          "minimum": {"type": "number"},
          "maximum": {"type": "number"},
          "enum_values": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "aliases": {"type": "object"},
          "finality": {
            "type": "object",
            "properties": {
              "confidence_threshold": {"type": "number", "minimum": 0, "maximum": 1},
              "min_confirmations": {"type": "integer", "minimum": 1},
              "min_span_seconds": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    }
  }
}
