{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-beast.local/schemas/evidence-procedure-claim-v1.json",
  "title": "Beast evidence-linked procedure claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "description", "evidence_event_ids", "review_state", "requires_human_review", "claim_id", "claim_fingerprint"],
  "properties": {
    "schema": {"const": "beast.evidence.procedure-claim/v1"},
    "description": {"type": "string", "minLength": 1},
    "evidence_event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^event-[0-9a-f]{24}$"}},
    "review_state": {"enum": ["observed", "inferred", "uncertain", "verified_by_execution", "rejected"]},
    "requires_human_review": {"type": "boolean"},
    "execution_receipt_id": {"type": "string", "minLength": 1},
    "claim_id": {"type": "string", "pattern": "^claim-[0-9a-f]{24}$"},
    "claim_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [{
    "if": {"properties": {"review_state": {"const": "verified_by_execution"}}},
    "then": {"required": ["execution_receipt_id"]}
  }]
}
