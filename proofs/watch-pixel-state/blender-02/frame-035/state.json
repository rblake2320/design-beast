  "text_elements": [
    {
      "track_id": 226,
      "text": "HOW TO BLOCK OUT",
      "bbox": [
        505,
        116,
        272,
        19
      ],
      "raw_ocr_score": 96.247002,
      "consecutive_frames": 1
    },
    {
      "track_id": 227,
      "text": "FOLLOW THE SHAPE LANGUAGE \u2014 Different characters use different shapes. Some are round, some are",
      "bbox": [
        79,
        219,
        1037,
        18
      ],
      "raw_ocr_score": 91.228165,
      "consecutive_frames": 1
    },
    {
      "track_id": 228,
      "text": "angular, and some are boxy. Your blockout should reflect the shape language of your chosen concept.",
      "bbox": [
        79,
        245,
        1006,
        19
      ],
      "raw_ocr_score": 91.185822,
      "consecutive_frames": 1
    },
    {
      "track_id": 229,
      "text": "BREAK THE CHARACTER INTO PARTS \u2014 Before sculpting, divide the character into major sections like the head,",
      "bbox": [
        79,
        294,
        1114,
        19
      ],
      "raw_ocr_score": 92.040504,
      "consecutive_frames": 1
    },
    {
      "track_id": 230,
      "text": "torso, arms, legs, hands, and feet. This makes the blockout process clearer and more organized.",
      "bbox": [
        78,
        321,
        940,
        18
      ],
      "raw_ocr_score": 93.062019,
      "consecutive_frames": 1
    },
    {
      "track_id": 231,
      "text": "USE SIMPLE SHAPES \u2014 Start with very simple primitive shapes in ERender. Keep the resolution low and avoid",
      "bbox": [
        79,
        360,
        1079,
        34
      ],
      "raw_ocr_score": 85.940079,
      "consecutive_frames": 1
    },
    {
      "track_id": 232,
      "text": "details so you can focus on the overall form.",
      "bbox": [
        78,
        396,
        430,
        19
      ],
      "raw_ocr_score": 96.090202,
      "consecutive_frames": 1
    },
    {
      "track_id": 233,
      "text": "STRAIGHT VS CURVES \u2014 Mixing straight and curved forms makes the character more appealing and dynamic.",
      "bbox": [
        78,
        445,
        1095,
        18
      ],
      "raw_ocr_score": 92.342575,
      "consecutive_frames": 1
    },
    {
      "track_id": 234,
      "text": "This helps avoid stiff or boring shapes.",
      "bbox": [
