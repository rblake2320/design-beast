  "transcript": {
    "method": "captions",
    "file": "transcript.txt",
    "segments": [
      {
        "id": "speech-0001",
        "time_seconds": 0.0,
        "time": "00:00:00.000",
        "text": "Hello, this is a video to show how can we make&nbsp;"
      },
      {
        "id": "speech-0002",
        "time_seconds": 0.0,
        "time": "00:00:00.000",
        "text": "transparent glass, frosted glass and colored grass in&nbsp;Blender"
      },
      {
        "id": "speech-0003",
        "time_seconds": 10.861,
        "time": "00:00:10.861",
        "text": "this is a setting we make before,"
      },
      {
        "id": "speech-0004",
        "time_seconds": 10.861,
        "time": "00:00:10.861",
        "text": "we can find this setting in previous video&nbsp;in this channel"
      },
      {
        "id": "speech-0005",
        "time_seconds": 17.558,
        "time": "00:00:17.558",
        "text": "in this setting, we use Cycles&nbsp;as a renderer,"
      },
      {
        "id": "speech-0006",
        "time_seconds": 21.517,
        "time": "00:00:21.517",
        "text": "and we add a area light for the lighting"
      },
      {
        "id": "speech-0007",
        "time_seconds": 25.143,
        "time": "00:00:25.143",
        "text": "a cube for the glass material&nbsp;"
      },
      {
        "id": "speech-0008",
        "time_seconds": 25.143,
        "time": "00:00:25.143",
        "text": "and the plane for the background color"
      },
      {
        "id": "speech-0009",
        "time_seconds": 32.7,
        "time": "00:00:32.700",
        "text": "for the background color,"
      },
      {
        "id": "speech-0010",
        "time_seconds": 32.7,
        "time": "00:00:32.700",
        "text": "in the previous video we&nbsp;set it in blue color"
      },
      {
        "id": "speech-0011",
        "time_seconds": 38.664,
        "time": "00:00:38.664",
        "text": "for this material setting, I go back to make it light grey"
      },
      {
        "id": "speech-0012",
