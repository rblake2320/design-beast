        0,
        0,
        0
      ],
      "object": "Ribbon",
      "rotation_deg": [
        0,
        0,
        0
      ],
      "scale": [
        1,
        0.3,
        1
      ]
    },
    {
      "action": "material",
      "id": "grid-color",
      "metallic": 0.15,
      "object": "Ribbon",
      "rgba": [
        0.04,
        0.35,
        0.8,
        1
      ],
      "roughness": 0.4
    },
    {
      "action": "bend",
      "angle_deg": 90,
      "axis": "Y",
      "id": "grid-bend",
      "object": "Ribbon"
    }
  ]
}
