{
  "blender_version": "5.1.2",
  "id": "bent-grid-diagnostic",
  "schema": "beast.blender.procedure/v1",
  "steps": [
    {
      "action": "add_mesh",
      "id": "grid-add",
      "object": "Ribbon",
